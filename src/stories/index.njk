<section class="stories section">
  <div class="container">
    <div class="stories__grid{{ ' stories__grid--single' if stories.length == 1 }}">
      {% for s in stories %}
        {% set rot = (loop.index0 % 2) + 1 %}
        {% include "story-card.njk" %}
      {% endfor %}
    </div>
    <p class="stories__more">Have a story to share about Layton? Email <a class="link-green" href="mailto:adam@laytonunlocked.com">adam@laytonunlocked.com</a></p>
  </div>
