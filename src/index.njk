<section class="hero hero--zine" style="background-image:url('/images/layton-hero.webp');background-size:cover;background-position:center;position:relative;">
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__heading">Layton.<br>Unlocked.</h1>
      <p class="hero__subhead">A neighbourhood pulling together - events, support, and community pride in the heart of Blackpool.</p>
      <a href="/whats-on/" class="btn btn--card btn--orange">See what's on &rarr;</a>
    </div>
  </div>
</section>

<section class="get-help section" id="get-help">
  <div class="container">
    <h2 class="section__heading">Need something?</h2>
    <p class="section__subhead">We've pulled together the best local support in one place. Whatever you're looking for, there's something here for you.</p>
  </div>

  <div class="help-scroll-track">
    <ul class="help-tiles">
      <li class="help-tile zc-rotate-1" style="background:var(--blue-sky)">
        <a class="help-tile__link-wrap" href="/food-essentials/">
          <div class="help-tile__icon help-tile__icon--photo" style="background-image:url('/images/image-3.webp')"></div>
          <span class="zc-badge zc-badge--dark">Need Food?</span>
          <h3 class="help-tile__cat">Food &amp; essentials</h3>
          <p class="help-tile__desc">Food pantries, community fridges, and emergency food support close to home.</p>
          <span class="help-tile__link">Find out more &rarr;</span>
        </a>
      </li>
      <li class="help-tile zc-rotate-2" style="background:var(--yellow)">
        <a class="help-tile__link-wrap" href="/whats-on/">
          <div class="help-tile__icon help-tile__icon--photo" style="background-image:url('/images/craft-club.webp')"></div>
          <span class="zc-badge zc-badge--dark">Get Out There</span>
          <h3 class="help-tile__cat">What's On</h3>
          <p class="help-tile__desc">From sports to arts to social clubs - free and low-cost activities for everyone.</p>
          <span class="help-tile__link">Find out more &rarr;</span>
        </a>
      </li>
      <li class="help-tile help-tile--cta zc-rotate-1" style="background:var(--green)">
        <a class="help-tile__link-wrap" href="mailto:adam@laytonunlocked.com">
          <div class="help-tile__icon help-tile__icon--photo" style="background-image:url('/images/hand-sunset.jpg')"></div>
          <span class="zc-badge zc-badge--dark">Say Hello</span>
          <h3 class="help-tile__cat">Can't find what you need?</h3>
          <p class="help-tile__desc">Get in touch with the Layton Unlocked team - we'll point you in the right direction.</p>
          <span class="help-tile__link">Contact us &rarr;</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<section class="featured-event section" id="whats-on">
  <div class="container featured-event__inner">
    <div class="featured-event__content">
      <span class="zc-badge zc-badge--dark">Every Monday, 9.30am-12.30pm</span>
      <h2 class="featured-event__heading">Living Well in Blackpool - Support Hub</h2>
      <p class="featured-event__body">A new weekly drop-in offering wraparound support with money, employment, housing, food, health, family worries and learning new skills. Come in, have a chat, and we'll help you find the right support.</p>
      <a href="/food-essentials/#fe-section-pinned" class="btn btn--card btn--teal">Find out more &rarr;</a>
    </div>
    <div class="featured-event__image-wrap featured-event__image-wrap--landscape zc-rotate-2">
      <img src="/images/living-well-support-hub.webp" alt="Living Well in Blackpool - Support Hub">
    </div>
  </div>
</section>


<section class="mission section mission--short" id="newsletter-cta">
  <div class="container mission__inner">
    <p>Want to know what's happening in Layton before everyone else? Join the Layton Loop and get events, activities and community news straight to your inbox - no spam, just the good stuff.</p>
    <p style="margin-top:0.5rem;"><a href="#newsletter" class="btn btn--card btn--yellow">Join the Layton Loop &darr;</a></p>
  </div>
</section>

<section class="stories section" id="our-stories">
  <div class="container">
    <div class="section__heading-group">
      <h2 class="section__heading">Our People. Our Stories.</h2>
      <span class="burst" aria-hidden="true"></span>
    </div>
    <p style="color:var(--black);font-size:1rem;font-weight:700;font-style:italic;margin:-4px 0 22px;">Illustrative examples while we collect real stories from Layton residents - not verbatim quotes.</p>

    <div class="stories__grid">
      <article class="story-card zc-rotate-1">
        <img class="story-card__placeholder" src="/images/florist.jpg" alt="Sandra, Layton resident">
        <blockquote class="story-card__quote">"I'd lived here ten years and never felt part of it. Coming to a Layton Unlocked event changed that completely."</blockquote>
        <p class="story-card__attribution"><span class="zc-badge zc-badge--teal">Sandra, Layton resident</span></p>
      </article>
      <article class="story-card zc-rotate-2">
        <img class="story-card__placeholder" src="/images/garden.jpg" alt="Marcus, community volunteer">
        <blockquote class="story-card__quote">"We set up a little community garden and suddenly people were talking to their neighbours for the first time."</blockquote>
        <p class="story-card__attribution"><span class="zc-badge zc-badge--orange">Marcus, community volunteer</span></p>
      </article>
    </div>
    <p class="stories__more"><a href="/layton-voices/" class="link-green">More stories coming soon &rarr;</a></p>
  </div>
</section>
