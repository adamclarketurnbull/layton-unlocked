---
layout: base.njk
title: What's On - Layton Unlocked
pinnedEvent: family-film-night-frankenweenie-24-october
pinnedEvent2: bonkers-bingo-quizzie-quiz-lch-fundraiser-night
---
<section class="page-hero page-hero--zine page-hero--teal" style="background-image:url('/images/whats-on-hero.jpg');background-size:cover;background-position:center;">
  <div class="page-hero__scrim" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    <h1 class="page-hero__heading">What's On</h1>
    <p class="page-hero__subhead">Regular clubs and classes, plus one-off events, happening in and around Layton every week.</p>
  </div>
</section>

{% set featured = events | findBy("slug", pinnedEvent) %}
{% set featured2 = events | findBy("slug", pinnedEvent2) %}
{# Card layout by image: portrait poster = side column, landscape/square poster = stacked on top, no image = text only #}
{% set f1cls = ("wo-featured--stack" if featured.landscape else "wo-featured--portrait") if featured.image else "wo-featured--noimg" %}
{% set f2cls = ("wo-featured--stack" if featured2.landscape else "wo-featured--portrait") if featured2.image else "wo-featured--noimg" %}
{% if featured %}
<section class="pinned-service section" style="padding-bottom:0;">
  <div class="container">
    <div class="wo-featured-grid{{ ' wo-featured-grid--single' if not featured2 }}">
      <article class="story-card wo-featured {{ f1cls }} zc-rotate-1" id="{{ featured.slug }}">
        {% if featured.image %}
          <img class="wo-featured__img" src="{{ featured.image }}" alt="{{ featured.title }}">
        {% endif %}
        <div class="wo-featured__body">
          <span class="zc-badge zc-badge--yellow">Coming up next</span>
          <p class="wo-featured__label">{{ featured | dateRange }} &middot; {{ featured.category }}</p>
          <h3>{{ featured.title }}</h3>
          <p class="wo-featured__meta">{{ featured.time }} &middot; {{ featured.location }}</p>
          <a class="wo-featured__cta" href="{{ featured.page or featured.link or '#' + featured.slug }}"{% if not featured.page %} target="_blank" rel="noopener"{% endif %}>See details &rarr;</a>
        </div>
      </article>
      {% if featured2 %}
      <article class="story-card wo-featured {{ f2cls }} zc-rotate-2" id="{{ featured2.slug }}">
        {% if featured2.image %}
          <img class="wo-featured__img" src="{{ featured2.image }}" alt="{{ featured2.title }}">
        {% endif %}
        <div class="wo-featured__body">
          <span class="zc-badge zc-badge--yellow">Coming up next</span>
          <p class="wo-featured__label">{{ featured2 | dateRange }} &middot; {{ featured2.category }}</p>
          <h3>{{ featured2.title }}</h3>
          <p class="wo-featured__meta">{{ featured2.time }} &middot; {{ featured2.location }}</p>
          <a class="wo-featured__cta" href="{{ featured2.page or featured2.link or '#' + featured2.slug }}"{% if not featured2.page %} target="_blank" rel="noopener"{% endif %}>See details &rarr;</a>
        </div>
      </article>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<section class="section wo-tight">
  <div class="container">
    <div class="section__heading-group">
      <h2 class="section__heading">Regular activities</h2>
      <p class="reassurance__body" style="max-width:640px;">Free, friendly, and open to everyone - filter by category or day to find something for you.</p>
    </div>

    <div class="wo-chips-row">
      <select class="wo-select" id="wo-filter-category" aria-label="Filter by activity type">
        <option value="All">All activity types</option>
        <option value="Fitness">Fitness</option>
        <option value="Family & Kids">Family &amp; Kids</option>
        <option value="Social">Social</option>
        <option value="Community">Community</option>
        <option value="Faith">Faith</option>
        <option value="Arts">Arts</option>
      </select>
      <select class="wo-select" id="wo-filter-day" aria-label="Filter by day">
        <option value="All">Every day</option>
        <option value="Mon">Mon</option>
        <option value="Tue">Tue</option>
        <option value="Wed">Wed</option>
        <option value="Thu">Thu</option>
        <option value="Fri">Fri</option>
        <option value="Sat">Sat</option>
        <option value="Sun">Sun</option>
      </select>
    </div>

    <div id="wo-activities-grid" class="wo-grid">
      {% for a in activities %}
      {% set cats = a.categories or [a.category] %}
      <a class="wo-card" href="{{ a.url or '#' }}" target="_blank" rel="noopener"
         data-day="{{ a.day }}" data-categories="{{ cats | join(',') }}">
        <div class="story-card__placeholder wo-card__ph {{ 'wo-card__ph--' + (a.category | slugify) if not a.image }}"
             {% if a.image %}style="background-image:url('{{ a.image }}');"{% endif %}>
          <span class="wo-card__day">{{ a.day }}</span>
        </div>
        <div class="wo-card__body">
          <p class="wo-card__cat">{{ a.category }}</p>
          <p class="wo-card__name">{{ a.emoji }} {{ a.name }}</p>
          <p class="wo-card__meta">{{ a.time }} &middot; {{ a.location }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
    <p class="wo-empty" id="wo-activities-empty" style="display:none;">Nothing matches that filter right now - try "All" on one of the dropdowns.</p>
    <div class="wo-loadmore-row">
      <button type="button" id="wo-activities-show-more" class="wo-show-more-btn btn--card">Show more</button>
    </div>
  </div>
</section>

<section class="section wo-tight wo-dark" style="padding-top:34px;">
  <div class="container">
    <div class="section__heading-group">
      <h2 class="section__heading" style="color:var(--white-warm);">One-off events</h2>
      <p class="reassurance__body" style="max-width:640px;color:#C9A98C;">Coming up - scroll for more.</p>
    </div>

    <div id="wo-events-strip" class="wo-grid">
      {% for e in events | upcoming %}
      <div class="wo-card">
        <a class="wo-card__link" href="{{ e.page or e.link or ('#' + e.slug) }}"{% if not e.page %} target="_blank" rel="noopener"{% endif %}>
          <div class="story-card__placeholder wo-card__ph {{ 'wo-card__ph--' + (e.category | slugify) if not e.image }}"
               {% if e.image %}style="background-image:url('{{ e.image }}');"{% endif %}>
            <span class="wo-card__day">{{ e | dateRange }}</span>
            {% if e.cost %}<span class="wo-card__cost wo-card__cost--{{ e.cost }}">{{ e.cost }}</span>{% endif %}
            {% if e.tag %}<span class="wo-card__tag">{{ e.tag }}</span>{% endif %}
          </div>
          <div class="wo-card__body">
            <p class="wo-card__cat">{{ e.category }}</p>
            <p class="wo-card__name">{{ e.title }}</p>
            <p class="wo-card__meta">{{ e.time }} &middot; {{ e.location }}</p>
          </div>
        </a>
        {% if e.venueLink %}<a class="wo-card__venue-link" href="{{ e.venueLink }}" target="_blank" rel="noopener">{{ e.venueLinkText or "Venue on Facebook →" }}</a>{% endif %}
      </div>
      {% if loop.index == 6 %}
      <div class="wo-card wo-card--promo">
        <div class="wo-card__promo-inner">
          <span class="wo-card__promo-icon" aria-hidden="true">&#x1F49A;</span>
          <p class="wo-card__promo-text">If Layton Unlocked helped you find this, mention it &ndash; it helps us a lot!</p>
        </div>
      </div>
      {% endif %}
      {% else %}
      <p class="wo-empty" style="color:#C9A98C;">No upcoming one-off events listed right now - check back soon.</p>
      {% endfor %}
    </div>
  </div>
</section>

<script src="/js/whats-on.js"></script>
